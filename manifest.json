{
  "manifest_version": 3,
  "name": "LocalWallet",
  "version": "1.2.0",
  "description": "Track balances of your money accounts in multiple currencies, with a snapshot history log. Optionally syncs to your own Google Drive.",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "identity"],
  "host_permissions": ["https://kurs.resenje.org/*", "https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.appdata"]
  },
  "action": { "default_title": "Open LocalWallet" },
  "background": { "service_worker": "background.js" }
}
